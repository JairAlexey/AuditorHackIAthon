# ── OpenAI ────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-proj-...
# Modelos con vision recomendados (más barato → más caro):
#   gpt-4o-mini  → ~17x más barato que gpt-4o, soporta vision, recomendado para hackathon
#   gpt-4.1-mini → alternativa más reciente, similar precio
#   gpt-4o       → máxima calidad, más caro
OPENAI_MODEL=gpt-4o-mini

# ── Supabase ──────────────────────────────────────────────────────────────────
# Encuéntralos en: Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Notion ────────────────────────────────────────────────────────────────────
# Integration Token: https://www.notion.so/my-integrations
NOTION_TOKEN=secret_...
# ID de la base de datos destino (URL: notion.so/.../<DATABASE_ID>?v=...)
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Frontend (opcional para producción) ───────────────────────────────────────
FRONTEND_URL=http://localhost:5173
